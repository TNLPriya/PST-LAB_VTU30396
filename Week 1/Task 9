PROBLEM STATEMENT:
Given an array of integers nums, find the leftmost pivot index. A pivot index is an index where the sum of all elements strictly 
to its left is equal to the sum of all elements strictly to its right. If no pivot index exists, return -1.
AIM:
To find the leftmost pivot index of an integer array using an efficient O(n) time algorithm.
JAVA CODE:
import java.util.*;
public class PivotIndex {
    public static int pivotIndex(int[] nums) {
        int totalSum = 0;
        // Calculate total sum
        for (int num : nums) {
            totalSum += num;
        }

        int leftSum = 0;

        // Find pivot index
        for (int i = 0; i < nums.length; i++) {
            int rightSum = totalSum - leftSum - nums[i];

            if (leftSum == rightSum) {
                return i;
            }

            leftSum += nums[i];
        }

        return -1;
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();
        int[] nums = new int[n];

        for (int i = 0; i < n; i++) {
            nums[i] = sc.nextInt();
        }

        int result = pivotIndex(nums);
        System.out.println(result);

        sc.close();
    }
}
