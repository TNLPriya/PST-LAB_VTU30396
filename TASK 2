AIM:
To write a Java program using Kadane's Algorithm to find the maximum possible profit from consecutive daily profit and loss values.
JAVA CODE:
public class MaxProfitKadane {

    // Function to find maximum profit using Kadane's Algorithm
    public static int maxProfit(int[] dailyChanges) {
        int maxSoFar = dailyChanges[0];
        int maxEndingHere = dailyChanges[0];

        for (int i = 1; i < dailyChanges.length; i++) {
            maxEndingHere = Math.max(
                dailyChanges[i],
                maxEndingHere + dailyChanges[i]
            );

            maxSoFar = Math.max(maxSoFar, maxEndingHere);
        }

        return maxSoFar;
    }

    public static void main(String[] args) {

        // Daily profit and loss values
        int[] dailyChanges = {-2, 3, -1, 2, -1, 2, -3, 4};

        System.out.println("Daily profit/loss values:");

        for (int val : dailyChanges) {
            System.out.print(val + " ");
        }

        System.out.println();

        int maxProfit = maxProfit(dailyChanges);

        System.out.println("Maximum possible profit: " + maxProfit);
    }
}
