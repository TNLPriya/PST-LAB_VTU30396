AIM:
To find all words in a given list that match a given pattern.
A word matches the pattern if there exists a bijection (one-to-one mapping) between the letters of the pattern and the letters of the word.
JAVA CODE:
import java.util.*;

public class FindAndReplacePattern {
    public static List<String> findAndReplacePattern(String[] words, String pattern) {
        List<String> result = new ArrayList<>();
        for (String word : words) {
            if (matches(word, pattern)) {
                result.add(word);
            }
        }
        return result;
    }

    private static boolean matches(String word, String pattern) {
        if (word.length() != pattern.length()) return false;

        Map<Character, Character> mapWordToPattern = new HashMap<>();
        Map<Character, Character> mapPatternToWord = new HashMap<>();

        for (int i = 0; i < word.length(); i++) {
            char w = word.charAt(i);
            char p = pattern.charAt(i);

            if (mapWordToPattern.containsKey(w) && mapWordToPattern.get(w) != p) {
                return false;
            }
            if (mapPatternToWord.containsKey(p) && mapPatternToWord.get(p) != w) {
                return false;
            }

            mapWordToPattern.put(w, p);
            mapPatternToWord.put(p, w);
        }
        return true;
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        // Input
        int n = sc.nextInt();
        sc.nextLine(); // consume newline
        String[] words = new String[n];
        for (int i = 0; i < n; i++) {
            words[i] = sc.nextLine();
        }
        String pattern = sc.nextLine();

        // Output
        List<String> result = findAndReplacePattern(words, pattern);
        System.out.println(result);

        sc.close();
    }
}
